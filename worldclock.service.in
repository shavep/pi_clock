[Unit]
Description=Full-screen Raspberry Pi world clock
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=__USER__
SupplementaryGroups=video render input
WorkingDirectory=/opt/pi-world-clock
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sh -c 'TERM=linux /usr/bin/setterm --blank 0 --powersave off --cursor off >&0'
ExecStart=/usr/bin/python3 /opt/pi-world-clock/worldclock.py
Restart=always
RestartSec=3
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
